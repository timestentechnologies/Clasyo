[Unit]
Description=Daphne ASGI Server for School SaaS
After=network.target redis-server.service

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/schoolsaas
Environment="PATH=/home/ubuntu/schoolsaas/venv/bin"
ExecStart=/home/ubuntu/schoolsaas/venv/bin/daphne -b 127.0.0.1 -p 8001 school_saas.asgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
